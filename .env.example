# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./test.db

# JWT Authentication
JWT_SECRET=supersecretkey12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Food-image vision (VLM) settings
# Models: gemini-3.5-flash-lite (default, highest free limits), gemini-3.6-flash (better detail)
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MAX_IMAGES=10
GEMINI_VISION_MAX_MB=10

# Voice Call Agent (Sarvam + Groq + Twilio)
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-or-public-url.ngrok.io
