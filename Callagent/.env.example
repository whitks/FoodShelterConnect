# Copy to ../.env (project root) or export these as environment variables.

# --- Sarvam (STT + TTS) ---
SARVAM_API_KEY=your_sarvam_api_key_here
# SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
# SARVAM_STT_MODEL=saaras:v3-realtime
# SARVAM_STT_LANGUAGE=auto
# SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech/stream
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_VOICE=simran
# SARVAM_TTS_LANGUAGE=hi-IN

# --- Groq (LLM) ---
GROQ_API_KEY=your_groq_api_key_here
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_LLM_MAX_TOKENS=400

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-or-public-url.ngrok.io

# --- Security (recommended for any public deployment) ---
# Shared secret appended to the Twilio <Stream> URL and required on the
# /media-stream WebSocket. Twilio forwards query params unchanged, so this
# authenticates Media Streams without breaking them. Leave empty to disable.
# MEDIA_STREAM_TOKEN=change-me-to-a-long-random-string
# Required X-Admin-Token header for POST /make-call. Leave empty to disable
# the endpoint entirely (prevents anonymous toll-fraud call placement).
# ADMIN_TOKEN=change-me-to-a-long-random-string
# MAX_CONCURRENT_CALLS=25

# --- Tuning (optional) ---
# ECHO_SUPPRESSION_SECONDS=0.6
# MAX_HISTORY_MESSAGES=20