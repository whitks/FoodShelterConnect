# Copy this file to `.env` and tweak values for your setup.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app.

# Voice server (FastAPI, backend/voice_agent/server/app.py) that the app dials.
# In development the app auto-derives this from the Expo dev server host, but
# set it explicitly when the server runs elsewhere (e.g. a Render deployment).
#
# http(s):// hosts are converted to ws(s):// automatically in voice.tsx, so
# either form is fine here:
#
#   Local dev server (your PC, same Wi-Fi as the phone):
#   EXPO_PUBLIC_VOICE_SERVER_URL=ws://192.168.1.10:8765
#
#   Hosted on Render:
#   EXPO_PUBLIC_VOICE_SERVER_URL=https://voie-agent.onrender.com