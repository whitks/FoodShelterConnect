# Copy this file to `.env` and tweak values for your setup.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app.

# Voice server (FastAPI, backend/voice_agent) reachable from your phone.
# In development the app auto-derives this from the Expo dev server host, but
# set it explicitly when the server runs elsewhere or in production.
#
# Example for a phone on the same Wi-Fi as the dev machine:
# EXPO_PUBLIC_VOICE_SERVER_URL=ws://192.168.1.10:8765
#
# EXPO_PUBLIC_VOICE_SERVER_URL=ws://localhost:8765